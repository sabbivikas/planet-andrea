# Planet Andrea Supabase Edge Function environment
#
# Copy this file to supabase/.env.local for local edge function development.
# Set production secrets with:
#   supabase secrets set --project-ref <project-ref> KEY=value

# Required for local edge functions when not supplied by the Supabase CLI runtime
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required if the custom auth email hook is enabled
SB_AUTH_HOOK_SECRETS_SEND_EMAIL=
SB_AUTH_HOOK_SEND_EMAIL_FROM=
RESEND_API_KEY=

# Optional auth hook secrets
SB_AUTH_HOOK_SECRETS_CUSTOM_ACCESS_TOKEN=
SB_AUTH_HOOK_SECRETS_SEND_SMS=
SB_AUTH_HOOK_SECRETS_PASSWORD_VERIFICATION_ATTEMPT=
SB_AUTH_HOOK_SECRETS_MFA_VERIFICATION_ATTEMPT=

# Optional email/AWS/Sentry integrations
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_SES_REGION=
SENTRY_DSN=
WAITLIST_INFO_WEBHOOK_URL=

# Optional product/API integrations already represented in the codebase.
# Leave blank unless the corresponding feature is configured.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
GOOGLE_VERTEX_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
OPENWEATHER_API_KEY=
FINNHUB_API_KEY=
ELEVENLABS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Optional analytics/purchases backend integrations
POSTHOG_PROJECT_TOKEN=
POSTHOG_PROJECT_ID=
POSTHOG_PROJECT_REGION=
REVENUE_CAT_API_KEY=
