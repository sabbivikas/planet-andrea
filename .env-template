# Planet Andrea frontend environment
#
# Copy this file to .env.local for local Expo development.
# Only EXPO_PUBLIC_* values are bundled into the client app. Never put service-role
# keys or private provider secrets in EXPO_PUBLIC_* variables.

# Required
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional Supabase auth behavior
EXPO_PUBLIC_SUPABASE_AUTH_FLOW_TYPE=pkce
EXPO_PUBLIC_SUPABASE_AUTH_DETECT_SESSION_IN_URL=true

# Optional app identifiers used by app.config.ts and EAS
EXPO_PUBLIC_APP_SCHEME=planetandrea
IOS_BUNDLE_IDENTIFIER=com.planetandrea.app
ANDROID_PACKAGE=com.planetandrea.app
EAS_PROJECT_ID=

# Optional analytics/crash reporting
EXPO_PUBLIC_POSTHOG_ENABLED=false
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_PROJECT_ID=
EXPO_PUBLIC_POSTHOG_PROJECT_REGION=us
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
EXPO_PUBLIC_CRASH_ANALYTICS_CONSOLE_ENABLED=false
EXPO_PUBLIC_CRASH_ANALYTICS_CONSOLE_PATCH_ENABLED=false

# Optional purchases
EXPO_PUBLIC_PURCHASE_ENV=sandbox
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
EXPO_PUBLIC_REVENUECAT_API_KEY_TEST_STORE=
EXPO_PUBLIC_STRIPE_API_SANDBOX_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_API_LIVE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_CALLBACK_URL=

# Optional native maps configuration.
# This is read by app.config.ts at build time, not exposed through EXPO_PUBLIC_*.
GOOGLE_MAPS_API_KEY=
