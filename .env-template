# Environment variable template for local development.
# (Originally generated by the Woz builder, which no longer exists - this file
# is now maintained by hand. Add new EXPO_PUBLIC_* vars here when you add them
# to the code.)


# Enable PostHog analytics for frontend
EXPO_PUBLIC_POSTHOG_ENABLED=
# Supabase Auth Flow Type for frontend
EXPO_PUBLIC_SUPABASE_AUTH_FLOW_TYPE=
# Supabase Auth Detect Session in URL for frontend
EXPO_PUBLIC_SUPABASE_AUTH_DETECT_SESSION_IN_URL=
# PostHog Project Region (us or eu) for frontend analytics
EXPO_PUBLIC_POSTHOG_PROJECT_REGION=
# Purchase Environment for frontend (sandbox or production)
EXPO_PUBLIC_PURCHASE_ENV=
# Supabase URL for frontend
EXPO_PUBLIC_SUPABASE_URL=
# Supabase Anon Key for frontend
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Expo Bundle URL for frontend
EXPO_PUBLIC_BUNDLE_URL=
# Sentry Auth Token for frontend
SENTRY_AUTH_TOKEN=
# Sentry Data Source Name for frontend error tracking
EXPO_PUBLIC_SENTRY_DSN=
# PostHog Project Token (phc_*) for frontend analytics
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
# PostHog Project ID for frontend analytics
EXPO_PUBLIC_POSTHOG_PROJECT_ID=
# Crash Analytics Console Enabled for frontend
EXPO_PUBLIC_CRASH_ANALYTICS_CONSOLE_ENABLED=
# Crash Analytics Console Patch Enabled for frontend
EXPO_PUBLIC_CRASH_ANALYTICS_CONSOLE_PATCH_ENABLED=
# Crash Analytics Parent Window Enabled for frontend
EXPO_PUBLIC_CRASH_ANALYTICS_PARENT_WINDOW_ENABLED=
# Expo Bundle URL (SSL) for frontend
EXPO_PUBLIC_BUNDLE_URL_SSL=
# Stripe Callback URL for frontend, useful for checkout sessions to redirect to after payment
EXPO_PUBLIC_STRIPE_CALLBACK_URL=
# If set to true, enables the Woz Inspector element inspector tool.
EXPO_PUBLIC_INSPECTOR_ENABLED=